#!/usr/bin/lua

local json = require 'luci.jsonc'
local app_version = 2

local function info_get()
	local f, err = io.open('/tmp/sysinfo/wwan_info')
	if not f then
		return nil, err
	end

	local s = f:read('*a')
	f:close()

	local parser = json.new()
	local r, err = parser:parse(s)
	if not r then
		return nil, err
	end

	return parser:get()
end

local function info_find(data, key)
	if data.res ~= nil and #data.res >= 1 then	
		local d = data.res[1]
		local find_val = function(key)
			for _, v in ipairs(d) do
				if v[key] ~= nil then
					return v[key]
				end
			end
			return ''
		end

		if key == 'ccid' then
			return find_val('iccid')
		end
		if key == 'cgsn' then
			return find_val('imei')
		end

		if key == 'device' then
			return find_val('vendor')..' '..find_val('product')
		end

		return find_val(key)
	else
		return data[v] ~= nil and data[v] or ''
	end
end

local function get_info(args)
	local data, err = info_get()
	if not data then
		print('')
		return
	end

	if args[1] == 'all' then
		val = json.stringify(data)
		print(val)
		return
	end

	for _, v in ipairs(args) do
		print(info_find(data, v))
	end

end

local args = {...}

local help = [[
usage: wwan_info <info_key>
	all - print all information
	ccid/iccid - SIM Card's CCID
	imei/cgsn - Modem IMEI
	device - Modem Vendor & Product info
	csq - Modem CSQ
	signal - Modem Signal strength (%)
	--version - Version
]]

if #args == 0 then
	print(help)
	return
end
if args[1] == '--version' or args[1] == 'version' then
	print(app_version)
	return
end

get_info(args)
