# Quectel RG255AA-CN

O=$(sms_tool -d $DEVICE at "at+qtemp")

T=$(echo "$O" | awk -F[,:] '/^\+QTEMP/ {print $2}' | sort -r | head -n1 | xargs)
[ -n "$T" ] && addon 10 "Temperature" "$T &deg;C"

if [ "$REGOK" = "0" ]; then
	if [ "x$MODE_NUM" = "x11" ] || [ "x$MODE_NUM" = "x12" ]; then
		O=$(sms_tool -d $DEVICE at "at+c5greg=2;+c5greg?")

		# C5GREG
		T=""
		TAC_HEX=""
		CID_HEX=""
		TAC_DEC=""
		eval $(echo "$O" | busybox awk -F[,] '/^\+C5GREG/ {gsub(/[[:space:]"]+/,"");printf "T=\"%d\";TAC_HEX=\"%X\";CID_HEX=\"%s\";TAC_DEC=\"%d\";MODE_NUM=\"%d\"", $2, "0x"$3, $4, "0x"$3, $5}')
		case "$T" in
			0*) REG="0";;
			1*) REG="1";;
			2*) REG="2";;
			3*) REG="3";;
			5*) REG="5";;
			*) REG="";;
		esac
		[ "x$REG" = "x1" ] || [ "x$REG" = "x5" ] && REGOK=1

		[ -n "$TAC_DEC" ] && [ "$TAC_DEC" != "0" ] && addon 23 "TAC" "${TAC_DEC} (${TAC_HEX})"
		[ -n "$CID_HEX" ] && CID_DEC=$(printf "%d" "0x${CID_HEX}")
	fi

	if [ "x$MODE_NUM" = "x7" ] || [ "x$MODE_NUM" = "x10" ]  || [ "x$MODE_NUM" = "x13" ]  || [ "x$MODE_NUM" = "x15" ]  || [ "x$MODE_NUM" = "x16" ]; then
		O=$(sms_tool -d $DEVICE at "at+cereg=2;+cereg?")

		# CEREG
		T=""
		TAC_HEX=""
		CID_HEX=""
		TAC_DEC=""
		eval $(echo "$O" | busybox awk -F[,] '/^\+CEREG/ {gsub(/[[:space:]"]+/,"");printf "T=\"%d\";TAC_HEX=\"%X\";CID_HEX=\"%s\";TAC_DEC=\"%d\";MODE_NUM=\"%d\"", $2, "0x"$3, $4, "0x"$3, $5}')
		case "$T" in
			0*) REG="0";;
			1*) REG="1";;
			2*) REG="2";;
			3*) REG="3";;
			5*) REG="5";;
			*) REG="";;
		esac
		[ "x$REG" = "x1" ] || [ "x$REG" = "x5" ] && REGOK=1

		[ -n "$TAC_DEC" ] && [ "$TAC_DEC" != "0" ] && addon 23 "TAC" "${TAC_DEC} (${TAC_HEX})"
		[ -n "$CID_HEX" ] && CID_DEC=$(printf "%d" "0x${CID_HEX}")
	fi
fi

if [ "$REGOK" = "1" ]; then

O=$(sms_tool -d $DEVICE at "at+qnwinfo;+qeng=\"servingcell\"")

case "$MODE_NUM" in
	10 | 13)
		MODE="5G NSA"
		;;
	11 | 12)
		MODE="5G SA"
		;;
	15)
		MODE="LTE-A"
		;;
	16)
		MODE="3G+"
		;;
esac

case "$MODE_NUM" in
	7 | 10 | 13 | 15 | 16)
		T=$(echo "$O" | awk -F[,:] '/^\+QNWINFO:.*LTE.*/{print $4}')
		if [ -n "$T" ]; then
			B=$(echo $T | sed 's/"LTE BAND \(.*\)"/\1/')
			MODE="$MODE $(band4g ${B})"
		fi
		;;
	11 | 12)
		T=$(echo "$O" | awk -F[,:] '/^\+QNWINFO:.*NR5G.*/{print $4}')
		if [ -n "$T" ]; then
			B=$(echo $T | sed 's/"NR N\(.*\)"/\1/')
			MODE="$MODE $(band5g ${B})"
		fi
		;;
esac

if [ "x$MODE_NUM" = "x7" ]; then
	T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $4}' | xargs)
	if [ "x$T" = "xLTE" ]; then
		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $14}')
		T_DEC=$(printf "%d" "0x$T")
		addon 23 "TAC" "${T_DEC} ($T)"
#		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $18}' | awk '{printf "%.1f\n", 0.2*$1*10 - 20}')
		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $18}' | xargs)
		addon 38 "SINR" "$T"
		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $12}')
		case $T in
			0*) T1="1.4";;
			1*) T1="3";;
			2*) T1="5";;
			3*) T1="10";;
			4*) T1="15";;
			5*) T1="20";;
			*) T1="";;
		esac
		[ -n "$T1" ] && addon 31 "Bandwidth UL" "$T1 MHz"
		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $13}')
		case $T in
			0*) T1="1.4";;
			1*) T1="3";;
			2*) T1="5";;
			3*) T1="10";;
			4*) T1="15";;
			5*) T1="20";;
			*) T1="";;
		esac
		[ -n "$T1" ] && addon 32 "Bandwidth DL" "$T1 MHz"
	fi
fi

if [ "x$MODE_NUM" = "x11" ] || [ "x$MODE_NUM" = "x12" ]; then
	T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $4}' | xargs)
	if [ "x$T" = "xNR5G-SA" ]; then
		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $8}')
		if [ -n "$T" ]; then
			CID_HEX=$T
			CID_DEC=$(printf "%d" "0x${CID_HEX}")
		fi
#		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $9}')
#		[ -n "$T" ] && addon 33 "PCI" "$T"
		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $13}')
		case $T in
			0) BW="5";;
			1) BW="10";;
			2) BW="15";;
			3) BW="20";;
			4) BW="25";;
			5) BW="30";;
			6) BW="40";;
			7) BW="50";;
			8) BW="60";;
			9) BW="70";;
			10) BW="80";;
			11) BW="90";;
			12) BW="100";;
			13) BW="200";;
			14) BW="400";;
			*) BW="";;
		esac
		[ -n "$BW" ] && addon 32 "Bandwidth" "$BW MHz"
		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $14}')
		if [ -n "$T" ]; then
			addon 36 "RSRP" "$T dBm"
			if [ -n "$BW" ]; then
				N=$((BW * 5))
				RSSI=$(echo "$T $N" | awk '{printf "%d\n", $1 + 10*log(12*$2)/log(10)}')
				if [ -n "$RSSI" ]; then
					[ $RSSI -lt -113 ] && RSSI="-113"
					[ $RSSI -gt -51 ] && RSSI="-51"
					addon 35 "RSSI" "$RSSI dBm"
					[ -z "$CSQ_PER" ] && CSQ_PER=$(((RSSI + 113) * 100 / 62 ))
				fi
			fi
		fi
		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $15}')
		[ -n "$T" ] && addon 37 "RSRQ" "$T dB"
		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $16}')
		[ -n "$T" ] && addon 38 "SINR" "$T"
	fi
fi

IFS="
"

if [ "x$MODE_NUM" = "x16" ] ||  [ "x$MODE_NUM" = "x10" ] ||  [ "x$MODE_NUM" = "x13" ]; then
	LINES=$(echo "$O" | grep "+QENG")
	for LINE in $LINES; do
		T=$(echo "$LINE" | awk -F[,:] '/^\+QENG:/{print $2}' | xargs)
		if [ "x$T" = "xLTE" ]; then
#			T=$(echo "$LINE" | awk -F[,:] '/^\+QENG:/ {print $12}')
#			T_DEC=$(printf "%d" "0x$T")
#			addon 23 "TAC" "${T_DEC} ($T)"
#			T=$(echo "$LINE" | awk -F[,:] '/^\+QENG:/ {print $16}' | awk '{printf "%.1f\n", 0.2*$1*10 - 20}')
			T=$(echo "$LINE" | awk -F[,:] '/^\+QENG:/ {print $16}' | xargs)
			addon 38 "SINR" "$T"
			T=$(echo "$LINE" | awk -F[,:] '/^\+QENG:/ {print $10}')
			case $T in
				0*) T1="1.4";;
				1*) T1="3";;
				2*) T1="5";;
				3*) T1="10";;
				4*) T1="15";;
				5*) T1="20";;
				*) T1="";;
			esac
			[ -n "$T1" ] && addon 31 "Bandwidth UL" "$T1 MHz"
			T=$(echo "$LINE" | awk -F[,:] '/^\+QENG:/ {print $11}')
			case $T in
				0*) T1="1.4";;
				1*) T1="3";;
				2*) T1="5";;
				3*) T1="10";;
				4*) T1="15";;
				5*) T1="20";;
				*) T1="";;
			esac
			[ -n "$T1" ] && addon 32 "Bandwidth DL" "$T1 MHz"
		fi
	done
fi

fi
